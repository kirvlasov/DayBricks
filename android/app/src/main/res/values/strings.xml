    <string name="action_add_template">+ Add new template</string>
    <!-- Empty-state guidance shown when no templates exist. -->
    <string name="template_empty_state">Start with something you do often: training, cooking, or a little time to focus.</string>
    <!-- Template duration summary when the template has no presets. %1$d is its default duration. -->
    <string name="template_duration_summary">%1$d min</string>
