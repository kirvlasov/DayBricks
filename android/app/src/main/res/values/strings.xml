    <string name="template_presets_help">Add activities you may want to schedule from this template. Each activity can have its own emoji, duration, and helpful instructions.</string>
    <!-- Saves a new or edited template. -->
    <string name="action_save_template">Save template</string>
    <!-- Shared icon-picker title for either a template or an activity. -->
    <string name="emoji_picker_title">Choose an icon</string>
    <!-- Removes the optional emoji from a template. -->
    <string name="emoji_no_icon">No icon</string>

    <!-- ===== Settings: calendars ===== -->

    <!-- Settings section selecting the single writable calendar used for new DayBricks events. -->
    <string name="settings_target_calendar_title">Calendar for creating activities</string>
    <!-- Placeholder when no writable target calendar has been selected. -->
    <string name="settings_choose_writable_calendar">Choose a writable calendar</string>
    <!-- Summary of a provider calendar. Both values are provider/user data. -->
    <string name="calendar_name_and_account">%1$s · %2$s</string>
    <!-- Explanation shown before requesting calendar permissions in Settings. -->
    <string name="calendar_permission_explanation">Calendar access lets DayBricks show your day and add the activities you confirm.</string>
    <!-- Button that launches Android's calendar permission prompt. -->
    <string name="action_allow_calendar_access">Allow calendar access</string>
    <!-- Opens the Android system page for DayBricks permissions and settings. -->
    <string name="action_open_android_app_settings">Open Android app settings</string>
    <!-- Empty state when Android exposes no calendar writable by DayBricks. -->
    <string name="settings_no_writable_calendars">No writable calendars found. Add a calendar account in Android, then return here.</string>
    <!-- Settings section for the multiple calendars visible on the DayBricks timeline. -->
    <string name="settings_display_calendars_title">Calendars to display</string>
    <!-- Empty state when Android exposes no readable calendar. -->
    <string name="settings_no_readable_calendars">No readable calendars</string>
    <!-- Display-filter summary. %1$d is visible count; %2$d is total readable count. -->
    <string name="settings_calendars_shown">%1$d of %2$d shown</string>
    <!-- Scope note for the display-calendar filter. -->
    <string name="settings_calendar_filter_help">This filter affects only the DayBricks timeline. New calendars are shown automatically.</string>

    <!-- ===== Settings: appearance and behavior ===== -->

    <!-- App color-theme setting. -->
    <string name="settings_theme">Theme</string>
    <!-- Grammatical answer to settings_theme: follow the Android system light/dark theme. -->
    <string name="choice_theme_system">System</string>
    <!-- Grammatical answer to settings_theme: always use the light app theme. -->
    <string name="choice_theme_light">Light</string>
    <!-- Grammatical answer to settings_theme: always use the dark app theme. -->
    <string name="choice_theme_dark">Dark</string>
    <!-- Setting for where the template panel appears. -->
    <string name="settings_template_panel">Template panel</string>
    <!-- Grammatical answer to settings_template_panel: let adaptive layout choose placement. Keep short. -->
    <string name="choice_template_panel_auto">Auto</string>
    <!-- Grammatical answer to settings_template_panel: force the panel to the right. Keep short. -->
    <string name="choice_template_panel_right">Right</string>
    <!-- Grammatical answer to settings_template_panel: force the panel to the bottom. Keep short. -->
    <string name="choice_template_panel_bottom">Bottom</string>
    <!-- Device-level value copied into newly created templates; existing templates are unaffected. -->
    <string name="settings_default_reminder">Calendar reminder (for new templates)</string>

    <!-- ===== Settings: optional template sync ===== -->

    <!-- Heading for connection to the user's self-hosted template sync service. -->
    <string name="settings_sync_server_title">Your sync server</string>
    <!-- Privacy/scope explanation for template synchronization. -->
    <string name="settings_sync_server_help">Optional. Only templates and shared preferences sync. Your calendar stays on your device.</string>
    <!-- URL input label. -->
    <string name="field_server_url">Server URL</string>
    <!-- Example only; not a real endpoint. -->
    <string name="server_url_example" translatable="false">https://activities.example.com</string>
    <!-- Secret authentication-token input label. -->
    <string name="field_api_token">API token</string>
    <!-- Explains why an empty token field does not erase the stored credential. -->
    <string name="api_token_keep_saved_help">Leave blank to keep the saved token.</string>
    <!-- Saves URL and optionally replaces the stored token. -->
    <string name="action_save_sync_settings">Save sync settings</string>
    <!-- Starts template synchronization immediately. -->
    <string name="action_sync_now">Sync now</string>
    <!-- Disabled button text while synchronization is running. -->
    <string name="sync_in_progress">Syncing…</string>
    <!-- Prefix before a locale-formatted last-success time. %1$s is a SHORT localized time. -->
    <string name="sync_last_success">Last sync: %1$s</string>
    <!-- Default sync status when no server is configured and no sync has succeeded. -->
    <string name="sync_offline_status">Works offline. No account needed.</string>

    <!-- ===== Snackbar, toast and recoverable error messages ===== -->

    <!-- Calendar permission was revoked or denied while reading/writing the provider. -->
    <string name="error_calendar_permission_required">Calendar permission is required. Enable access in Settings.</string>
    <!-- Generic persistence failure; intentionally avoids technical details. -->
    <string name="error_could_not_save">Could not save the change. Please try again.</string>
    <!-- Confirmation after sync URL/token settings are persisted locally. -->
    <string name="message_sync_settings_saved">Sync settings saved</string>
    <!-- Placement confirmation attempted before calendar permission was granted. -->
    <string name="error_allow_calendar_before_adding">Allow Calendar access before adding an activity.</string>
    <!-- Placement confirmation attempted without a target writable calendar. -->
    <string name="error_choose_calendar_for_blocks">Choose a calendar for creating activities.</string>
    <!-- Placement confirmation attempted with an empty event title. -->
    <string name="error_block_name_required">Give this activity a name.</string>
    <!-- Success snackbar after Android Calendar Provider accepted an event. -->
    <string name="message_block_added">Activity added to your calendar</string>
    <!-- Toast shown when no installed app can handle the calendar event-view intent. -->
    <string name="error_install_calendar_app">Install a calendar app to view this event</string>
    <!-- Safe sync error shown instead of server bodies or credential details. -->
    <string name="error_sync_failed">Sync failed. Check the connection, server URL and token. Local changes are safe.</string>
    <!-- Sync validation error when production URL is not HTTPS. -->
    <string name="error_https_required">Use an HTTPS server URL</string>
    <!-- Sync validation error when authentication token is missing. -->
    <string name="error_api_token_required">Enter an API token</string>
    <!-- Sync validation error when token is missing from Settings. -->
    <string name="error_api_token_required_in_settings">Enter an API token in Settings</string>
    <!-- Sync validation error for a remote state exceeding the client safety limit. -->
    <string name="error_server_state_too_large">Server state is too large</string>

    <!-- ===== Timeline accessibility and event status ===== -->

    <!-- RSVP status: current calendar user accepted the invitation. -->
    <string name="attendance_accepted">accepted</string>
    <!-- RSVP status: current calendar user answered maybe/tentative. -->
    <string name="attendance_tentative">tentative</string>
    <!-- RSVP status: invitation needs a response. -->
    <string name="attendance_needs_action">not answered</string>
    <!-- RSVP status: current calendar user declined the invitation. -->
    <string name="attendance_declined">declined</string>
    <!-- RSVP status is absent or not understood. -->
    <string name="attendance_unknown">status unknown</string>
    <!-- TalkBack description for an event. %1$s title, %2$s status, %3$s start, %4$s end. -->
    <string name="event_accessibility_description">%1$s, %2$s, %3$s–%4$s</string>
    <!-- Prefix in TalkBack indicating an event was created by DayBricks. Product name remains unchanged. -->
    <string name="event_owned_prefix">DayBricks · %1$s</string>

    <!-- ===== Validation strings that may surface through future field-level errors ===== -->

    <!-- Schema-version validation from imported or synchronized state; normally replaced by a generic UI message today. -->
    <string name="validation_unsupported_schema">Unsupported schema version</string>
    <!-- Template identifier validation from imported or synchronized state; normally replaced by a generic UI message today. -->
    <string name="validation_invalid_template_id">Invalid template ID</string>
    <!-- Template or preset name validation. The numeric limits are product constraints and must remain unchanged. -->
    <string name="validation_name_length">Name must contain 1–200 characters</string>
    <!-- Template duration validation. Both numeric limits are product constraints and must remain unchanged. -->
    <string name="validation_duration_range">Duration must be 1–720 minutes</string>
    <!-- Reminder validation. Seven days is the maximum accepted lead time. -->
    <string name="validation_reminder_range">Reminder must be no more than 7 days</string>
    <!-- Calendar read/write failure when Android's Calendar Provider is unavailable. -->
    <string name="validation_calendar_provider_unavailable">Calendar provider unavailable</string>
    <!-- Calendar write validation when the previously selected target is no longer writable. -->
    <string name="validation_select_writable_calendar">Select another writable calendar</string>
    <!-- Synchronization protocol validation when a server returns a malformed entity tag. ETag is an HTTP term and normally stays unchanged. -->
    <string name="validation_invalid_etag">Invalid ETag</string>
    <!-- Per-app language. On Android 13+ this selection is shared with Android's app-language settings. -->
    <string name="settings_language">Language</string>
    <!-- Grammatical answer to settings_language: follow Android's current system language. -->
    <string name="choice_language_system">System language</string>

    <!-- First-run flow: language must be chosen before starter templates are installed. -->
    <string name="onboarding_language_title">Choose your language</string>
    <string name="onboarding_setup_title">Set up DayBricks</string>
    <string name="settings_title">Settings</string>

