    <string name="action_edit">Edit</string>
    <!-- TalkBack label for editing one activity inside a template. %1$s is the user-authored activity name. -->
    <string name="action_edit_activity">Edit %1$s</string>
    <!-- Template overflow-menu action that moves the item earlier in the list. -->
    <string name="action_move_up">Move up</string>
    <!-- Template overflow-menu action that moves the item later in the list. -->
    <string name="action_move_down">Move down</string>
    <!-- Template overflow-menu action that permanently deletes the template, not calendar events. -->
    <string name="action_delete">Delete</string>

