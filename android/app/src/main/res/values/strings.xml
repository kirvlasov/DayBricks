    <!-- ===== Planner header and navigation ===== -->

    <!-- Pattern for the selected-day heading. EEEE is the localized weekday and MMMM the localized month. Translators may reorder fields and add punctuation. -->
    <string name="planner_date_header_pattern">EEEE, d MMMM</string>
    <!-- TalkBack description for the button that shows more hours by reducing vertical scale. -->
    <string name="action_zoom_out">Zoom out</string>
    <!-- TalkBack description for the button that shows fewer hours with larger calendar rows. -->
    <string name="action_zoom_in">Zoom in</string>
    <!-- TalkBack description for opening application settings. -->
    <string name="action_open_settings">Settings</string>
    <!-- TalkBack description for moving the planner to the previous calendar day. -->
    <string name="action_previous_day">Previous day</string>
    <!-- TalkBack description for moving the planner to the next calendar day. -->
    <string name="action_next_day">Next day</string>
    <!-- TalkBack description for opening the template library. -->
    <string name="action_open_template_library">Open template library</string>
    <!-- TalkBack description for closing the template library. -->
    <string name="action_close_template_library">Close template library</string>

    <!-- Banner shown when DayBricks cannot read the Android calendar. -->
    <string name="calendar_permission_banner">Connect your calendar to see your day.</string>
    <!-- Short permission action in the planner banner. -->
    <string name="action_allow_access">Allow access</string>
    <!-- Label appended after an all-day event title. %1$s is an event title and must not be translated. -->
    <string name="event_all_day">%1$s · All day</string>

    <!-- ===== Event placement editor ===== -->

    <!-- Label and compact edit-dialog title for the event title field. -->
    <string name="event_title_prompt">What will you do?</string>
    <!-- Fallback title for a draft whose title is unexpectedly empty. -->
    <string name="event_new_block_fallback">New activity</string>
    <!-- Button that accepts a draft and creates the calendar event. -->
    <string name="action_confirm_block">Confirm activity</string>
    <!-- Button that discards the current event-placement draft. -->
    <string name="action_cancel_placement">Cancel placement</string>
    <!-- Generic affirmative action that closes a dialog after edits. -->
    <string name="action_done">Done</string>
    <!-- Generic action that closes a dialog without applying the operation. -->
    <string name="action_cancel">Cancel</string>
    <!-- Opens placement without selecting one of a template's presets. Ellipsis indicates a further editor step. -->
    <string name="action_custom">Custom…</string>

    <!-- Short visual duration label used on the ruler. %1$d is a whole minute count; keep it compact. -->
    <string name="duration_minutes_short">%1$d min</string>
    <!-- Full duration phrase for TalkBack. Quantity is an integer minute count. Translators must add every plural category required by their locale; code uses pluralStringResource. -->
    <plurals name="duration_minutes_accessibility">
        <!-- %1$d is the duration. -->
        <item quantity="one">%1$d minute</item>
        <item quantity="other">%1$d minutes</item>
    </plurals>
    <!-- TalkBack name of the horizontal control that changes event duration. -->
    <string name="duration_control">Duration</string>
    <!-- TalkBack custom action that increases duration by one minute. -->
    <string name="duration_increase">Increase</string>
    <!-- TalkBack custom action that decreases duration by one minute. -->
    <string name="duration_decrease">Decrease</string>
    <!-- Time range displayed for a draft or event. %1$s and %2$s are locale-formatted clock times. -->
    <string name="time_range">%1$s → %2$s</string>
    <!-- Draft summary. Times are locale-formatted, and %3$d is a whole minute count. -->
    <string name="draft_time_summary">%1$s → %2$s · %3$d min</string>
    <!-- Offset shown only when a local wall-clock hour occurs twice during a DST transition. %1$s is an offset such as +02:00. -->
    <string name="utc_offset_label">UTC%1$s</string>

    <!-- ===== Reminders ===== -->

    <!-- Field label for the reminder override on the event-placement screen. -->
    <string name="reminder_label">Reminder</string>
    <!-- Field label for the reminder stored in a template. -->
    <string name="reminder_default_label">Default reminder</string>
    <!-- Grammatical answer to reminder_label, reminder_default_label, or settings_default_reminder: no notification. -->
    <string name="reminder_none">None</string>
    <!-- Grammatical answer to reminder_label, reminder_default_label, or settings_default_reminder: notify when the event begins. -->
    <string name="reminder_at_start">At start time</string>
    <!-- Grammatical answer to the reminder labels: notify this many minutes before. %1$d is a whole minute count. Translators must add every plural category required by their locale. -->
    <plurals name="reminder_minutes_before">
        <item quantity="one">%1$d min before</item>
        <item quantity="other">%1$d min before</item>
    </plurals>
    <!-- Grammatical answer to the reminder labels: notify one hour before. -->
    <string name="reminder_one_hour_before">1 hour before</string>

    <!-- ===== Template library ===== -->

    <!-- TalkBack description for the drag handle that closes a bottom template panel. -->
    <string name="action_close_template_panel">Close template panel</string>
    <!-- TalkBack description for a close icon inside a transient template panel. -->
    <string name="action_close_templates">Close templates</string>
    <!-- Heading of the reusable template library. -->
    <string name="template_library_title">Your templates</string>
    <!-- Supporting line below the template-library heading. -->
    <string name="template_library_subtitle">Choose one. Make time for it.</string>
