    <string name="template_editor_new_title">Create template</string>
    <!-- Dialog title when changing a reusable template that can contain activities. -->
    <string name="template_editor_edit_title">Edit template</string>
    <!-- Template-name input label. -->
    <string name="field_name">Name</string>
